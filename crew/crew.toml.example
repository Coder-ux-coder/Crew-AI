# Crew settings. Copy to ~/.crew/crew.toml (crew setup does this) and edit.
# Every value has a sensible default; delete what you do not need.

[team]
mode = "auto"            # "auto": one builder + reviewers for small jobs, the full team for big ones; or "solo" / "team"
max_hours = 0            # 0 = no time limit; or a number of hours to stop after
stall_minutes = 8        # an agent silent this long is nudged, then restarted
ledger_minutes = 12      # no task moving for this long -> the lead must replan
chat_budget = 8          # chat messages per agent per task (blockers are always allowed)
review = "cross"         # the manager model checks every piece, on another account than its author's; "off" = no review
ceo_reviews = true       # the CEO model reviews the plan and the final result
deliver = "merge"        # "merge" into your project, "branch" (leave it separate), or "push" to GitHub
permission_mode = "bypassPermissions"   # agents act without asking (default). Safer: "auto"
web_port = 8765
workhorse_seats = 2      # Sonnet 5.5 seats in a team, spread over your Claude subscriptions (most tasks by count)

# Three tiers. Token targets: manager 60-70%, CEO about 5%, workhorse the rest.
[models]
work = "claude-opus-5-5"         # the manager: plans, reviews every workhorse task, builds what needs high intelligence
workhorse = "claude-sonnet-5-5"  # the workhorse: routine, fully specified work (runs on your Claude plans)
ceo = "gpt-6-astra"              # the CEO, used sparingly: plan review, rulings, final approval
ceo_backup = "claude-fable-5-1"  # the CEO when ChatGPT cannot run it (no subscription, a limit, an error)
allowed = ["claude-opus-5-5", "claude-sonnet-5-5", "claude-fable-5-1"]
banned = ["haiku", "terra", "luna", "gpt-6-sol"]
effort_work = "auto"             # auto (the CEO decides per task) | low | medium | high | xhigh | max
effort_light = "auto"            # small jobs such as refining your request
effort_ceo = "max"               # the CEO always thinks hardest (GPT-6 also offers "ultra")

# One block per subscription. profile = "default" uses the normal sign-in of that tool;
# other accounts get their own folder under ~/.crew/accounts and are signed in by `crew setup`.
[[account]]
name = "claude-1"
vendor = "claude"
profile = "default"

[[account]]
name = "claude-2"
vendor = "claude"

[[account]]
name = "claude-3"
vendor = "claude"

[[account]]
name = "codex-1"
vendor = "codex"
profile = "default"

# Seats (the agents) default to one manager seat per Claude account (the first is the lead)
# and `workhorse_seats` Sonnet 5.5 seats spread over the Claude accounts. ChatGPT accounts
# run the CEO and ChatGPT chats; they get no seats.
# To choose yourself, add blocks like:
# [[seat]]
# name = "ada"
# vendor = "claude"
# account = "claude-1"
# role = "lead"
# tier = "manager"        # or "workhorse" (runs the workhorse model)
